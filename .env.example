DATABASE_URL=postgresql://nomflow:nomflow@localhost:5432/nomflow
REDIS_URL=redis://localhost:6379
# Almacenamiento de objetos (Garage, compatible con S3). stack:up genera las credenciales del .env local.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=nomflow-private
# Bucket exclusivo de las pruebas de navegador y de integración.
S3_TEST_BUCKET=nomflow-test
# Clave de acceso: GK + 24 hex; secreto: 64 hex. Las crea `scripts/garage-init.sh` en Garage.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Secretos del propio Garage (solo el contenedor los lee).
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# API de administración de Garage, para medir el espacio libre (Salud del sistema).
GARAGE_ADMIN_ENDPOINT=http://localhost:3903
# Clave con la que la aplicación cifra cada objeto antes de subirlo. Obligatoria (mínimo 32 caracteres) para usar el almacén; independiente de SESSION_SECRET.
# Generar con: openssl rand -base64 48. Guardar una copia FUERA de este equipo (ver docs/backup-clave-objetos.md).
# Perderla o cambiarla sin re-cifrar deja los documentos ilegibles.
OBJECT_ENCRYPTION_KEY=
# Obligatorio, mínimo 32 caracteres. Generar con: openssl rand -base64 48
SESSION_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NOMFLOW <no-reply@nomflow.local>"

# Carpeta donde se depositan los PDF <n_ide>_<año>.pdf de certificados de retención
TAX_CERT_INBOX_DIR=./data/certificados-retencion

# Cifrado de secretos guardados desde la administración (clave del servicio de festivos). Si se omite se deriva de SESSION_SECRET.
SETTINGS_ENCRYPTION_KEY=
HOLIDAY_API_TIMEOUT_MS=10000

# Reautenticación reciente (pedir la clave en acciones sensibles de la administración). Desactivada por omisión.
REQUIRE_RECENT_AUTH=false
