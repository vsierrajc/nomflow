    "admin:bootstrap": "node dist/db/bootstrap-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/testing": "^11.2.6",
    "@node-rs/argon2": "^2.2.1",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "archiver": "5.3.2",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.10",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
